{
  "name": "receipt-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "pnpm check:env && pnpm bootstrap:owner",
    "dev": "next dev",
    "prestart": "pnpm check:env && pnpm bootstrap:owner",
    "start": "next start",
    "build": "next build",
    "check:env": "node --import=tsx scripts/check-env.ts",
    "bootstrap:owner": "node --import=tsx scripts/bootstrap-owner.ts",
    "db:migrate": "node --import=tsx scripts/migrate.ts",
    "worker:extract": "node --import=tsx scripts/extraction-worker.ts",
    "smoke:auth": "node --import=tsx scripts/smoke-auth.ts",
    "smoke:intake": "node --import=tsx scripts/smoke-intake.ts",
    "smoke:extraction": "node --import=tsx scripts/smoke-extraction.ts",
    "smoke:queue-state": "node --import=tsx scripts/smoke-queue-state.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"fixtures/**/*.json\" \"*.{json,mjs,mts,yml}\" compose.yaml README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"fixtures/**/*.json\" \"*.{json,mjs,mts,yml}\" compose.yaml README.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ocr": "python3 -m unittest discover -s scripts -p 'test_ocr_*.py'",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:ocr && pnpm build"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
